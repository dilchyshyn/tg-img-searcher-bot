# Токен від @BotFather
BOT_TOKEN=

# Основний провайдер пошуку: google (Google Custom Search API), serpapi
# або duckduckgo (безкоштовно, ключ не потрібен)
SEARCH_PROVIDER=google

# Для SEARCH_PROVIDER=google
# Ключ: https://console.cloud.google.com/apis/credentials (увімкніть "Custom Search API")
GOOGLE_API_KEY=
# ID пошукової системи (cx): https://programmablesearchengine.google.com
# (увімкніть "Пошук зображень" і "Шукати в усьому інтернеті")
GOOGLE_CSE_ID=

# Для SEARCH_PROVIDER=serpapi: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Якщо основний провайдер видав помилку (напр. скінчилась квота) — шукати в DuckDuckGo
DUCKDUCKGO_FALLBACK=true

# Безпечний пошук (true/false)
SAFE_SEARCH=true
# Скільки секунд Telegram кешує результати inline-запиту
CACHE_TIME=300
